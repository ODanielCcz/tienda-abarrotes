# Copiar como .env y reemplazar todos los valores locales.
POSTGRES_DB=tienda_abarrotes
POSTGRES_USER=tienda_owner
POSTGRES_PASSWORD=reemplazar_con_clave_local_segura
POSTGRES_PORT=5433

PGADMIN_DEFAULT_EMAIL=admin@tienda-abarrotes.dev
PGADMIN_DEFAULT_PASSWORD=reemplazar_con_clave_local_segura
PGADMIN_PORT=5050

TZ=UTC

# Seguridad del backend. Genera un secreto Base64 aleatorio de al menos 32 bytes.
# Ejemplo PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
JWT_SECRET_BASE64=reemplazar_con_secreto_base64_local
JWT_ISSUER=tienda-abarrotes-api
JWT_ACCESS_TOKEN_TTL=PT30M

# Alta inicial opcional, solo para el perfil local.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrador local

# Clientes permitidos y observabilidad.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8100
TRACING_SAMPLING_PROBABILITY=0.1
OTLP_TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
